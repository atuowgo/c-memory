# 以下变量均为可选：不配置时系统自动降级为纯规则 + TF-IDF 模式
# （NullProvider + TfidfProvider），闭环仍能跑通，只是语义分析和召回精度会弱一些。

# LLM Provider 选型：deepseek / openai / anthropic 三选一（不区分大小写），
# 不设置或填了不认识的值都会降级为 NullProvider（规则兜底，不发真实请求）。
# 选中的 Provider 如果对应 *_API_KEY 为空，同样会降级为 NullProvider。
LLM_PROVIDER=

# --- DeepSeek（OpenAI 兼容接口）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Embedding Provider 选型：ark / openai / tfidf 三选一（不区分大小写），
# 不设置或填了不认识的值都会降级为 TfidfProvider（本地 sklearn 兜底，不需要任何 key）。
# 选中的 Provider 如果对应 *_API_KEY 为空，同样会降级为 TfidfProvider。
EMBEDDING_PROVIDER=

# 火山引擎 Ark：用于 memory 召回的 embedding。ARK_EMBEDDING_DIM 不填默认 2048。
ARK_API_KEY=
ARK_EMBEDDING_BASE_URL=
ARK_EMBEDDING_MODEL=
ARK_EMBEDDING_DIM=

# 兼容 OpenAI /embeddings 接口格式的通用 Provider（不限定官方 OpenAI，可指向任意中转/自建网关）。
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=
