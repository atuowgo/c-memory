{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python3 ${CLAUDE_PROJECT_DIR}/hooks/observe.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python3 ${CLAUDE_PROJECT_DIR}/hooks/extract.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python3 ${CLAUDE_PROJECT_DIR}/hooks/summarize.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python3 ${CLAUDE_PROJECT_DIR}/hooks/summarize.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python3 ${CLAUDE_PROJECT_DIR}/hooks/summarize.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python3 ${CLAUDE_PROJECT_DIR}/hooks/inject.py"
          }
        ]
      }
    ]
  }
}
